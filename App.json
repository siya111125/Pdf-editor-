{
  "expo": {
    "name": "PDFGo Editor",
    "slug": "pdfgo-editor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.pdfgo.mobileapp",
      "permissions": ["READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      [
        "expo-document-picker",
        {
          "photosPermission": "Allow access to select PDF documents."
        }
      ]
    ]
  }
}
